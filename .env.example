# Supabase Configuration
# Get these from: https://supabase.com/dashboard → Project Settings → API
# ⚠️  You need the SERVICE_ROLE key (starts with 'eyJ'), NOT the anon/publishable key.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase Storage bucket name (must match your bucket in Supabase dashboard)
SUPABASE_BUCKET=your-bucket-name

# Supabase JWT Secret (for verifying auth tokens)
# Found at: https://supabase.com/dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Server port (optional, defaults to 3001 for API)
PORT=3001
